# Copy this file to .env and fill in real values before deploying to production.
# This is a static Astro site - these are build-time values only (Astro exposes
# any PUBLIC_-prefixed variable to the client bundle; never put a real secret
# behind that prefix).

# Where the Contact and Schedule Now forms submit to. Point this at your real
# Formspree endpoint (or equivalent form backend) before launch - it currently
# falls back to a non-functional placeholder if unset.
PUBLIC_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Optional: Google Analytics 4 measurement ID (see src/scripts/analytics.ts
# and src/scripts/form-tracking.ts). Nothing is loaded or sent until this is
# set. Once it is, every form marked data-track-form (the hero quote form,
# Schedule Now, Contact) automatically fires a form_submit dataLayer event
# and a GA4 generate_lead event on submit, including which services were
# selected - no further wiring needed to start seeing lead data in GA4.
# PUBLIC_GA_MEASUREMENT_ID=

# Optional: Google Maps / Places API key, if a map is added to the Contact page.
# PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: Sentry DSN for client-side error monitoring (see
# src/scripts/error-monitoring.ts). Nothing is loaded or sent until this is
# set - failures are otherwise invisible until a client reports them.
# PUBLIC_SENTRY_DSN=
