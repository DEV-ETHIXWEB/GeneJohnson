---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CTASection from "../../components/CTASection.astro";
import { locations } from "../../data/locations";
import { site } from "../../data/site";
import { breadcrumbSchema } from "../../lib/schema";

const regions = ["Seattle Metro", "Eastside", "North Sound", "South Sound"] as const;
---

<BaseLayout
  title="Service Area - Puget Sound Heating, Cooling, Plumbing & Electrical"
  description="Gene Johnson serves homeowners across Seattle, the Eastside, North Sound, and South Sound. Find your city for local heating, cooling, plumbing, and electrical service."
  path="/service-area/"
  schema={[breadcrumbSchema([{ name: "Home", url: site.url }, { name: "Service Area", url: `${site.url}/service-area/` }])]}
>
  <PageHero
    eyebrow="Where we work"
    title="Serving the greater Puget Sound area"
    tagline="From Everett to Puyallup, our licensed technicians cover heating, cooling, plumbing, and electrical work across four counties."
    icon="Since 1976"
    breadcrumbs={[{ name: "Home", href: "/" }, { name: "Service Area" }]}
  />

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    {regions.map((region) => (
      <div class="mb-12" data-animate>
        <h2 class="font-display text-xl font-bold text-navy-900">{region}</h2>
        <div class="mt-5 grid gap-3 sm:grid-cols-3 lg:grid-cols-4" data-animate-group>
          {locations.filter((l) => l.region === region).map((l) => (
            <a href={`/${l.slug}/`} data-animate-item class="rounded-xl border border-navy-900/10 bg-white px-4 py-3 text-sm font-semibold text-navy-900 transition-colors hover:border-brand-red-300 hover:bg-cream-100">
              {l.name}
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <CTASection />
</BaseLayout>
