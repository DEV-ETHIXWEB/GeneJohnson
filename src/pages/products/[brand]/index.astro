---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import CTASection from "../../../components/CTASection.astro";
import { brands } from "../../../data/brands";
import { site } from "../../../data/site";
import { breadcrumbSchema } from "../../../lib/schema";
import CallNowCard from "../../../components/CallNowCard.astro";

export function getStaticPaths() {
  return brands.map((b) => ({ params: { brand: b.slug }, props: { b } }));
}

const { b } = Astro.props;
const path = `/products/${b.slug}/`;
---

<BaseLayout
  title={`${b.name} - ${b.category}`}
  description={b.description}
  path={path}
  schema={[
    breadcrumbSchema([
      { name: "Home", url: site.url },
      { name: "Products", url: `${site.url}/products/` },
      { name: b.name, url: `${site.url}${path}` },
    ]),
  ]}
>
  <PageHero
    eyebrow={b.category}
    title={b.name}
    tagline={b.description}
    breadcrumbs={[{ name: "Home", href: "/" }, { name: "Products", href: "/products/" }, { name: b.name }]}
  />

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[1fr_320px]">
      <div class="max-w-2xl">
        <h2 class="font-display text-2xl font-bold text-navy-900">Why we install {b.name}</h2>
        <ul class="mt-6 space-y-3" data-animate-group>
          {b.highlights.map((h) => (
            <li data-animate-item class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent-green-600" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.4 7.4a1 1 0 01-1.4 0L3.3 9.5a1 1 0 111.4-1.4l3.9 3.9 6.7-6.7a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
              <span class="text-sm text-ink-700">{h}</span>
            </li>
          ))}
        </ul>
        <p class="mt-8 text-sm text-ink-500">
          Want to know if {b.name} is the right fit for your home? A free in-home estimate is the fastest way to compare it against other brands for your specific space and budget.
        </p>
      </div>
      <div class="lg:sticky lg:top-28 lg:self-start">
        <CallNowCard />
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
