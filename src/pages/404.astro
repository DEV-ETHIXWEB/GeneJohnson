---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { verticals } from "../data/services";
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist or has moved. Find a service, browse the site, or call Gene Johnson directly."
  path="/404/"
  noindex
>
  <section class="relative overflow-hidden bg-navy-900 py-20 sm:py-28">
    <div class="bg-grid pointer-events-none absolute inset-0 opacity-30"></div>
    <div
      data-parallax="0.15"
      class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-brand-red-600/25 blur-3xl"
    ></div>

    <div class="relative mx-auto flex max-w-3xl flex-col items-center px-4 text-center sm:px-6 lg:px-8" data-animate>
      <span class="flex h-16 w-16 items-center justify-center rounded-2xl border border-white/15 bg-white/10 backdrop-blur">
        <svg class="h-9 w-9 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="11" cy="11" r="7" />
          <path d="M21 21l-4.5-4.5" stroke-linecap="round" />
          <path d="M8.5 11h5" stroke-linecap="round" />
        </svg>
      </span>

      <p class="mt-6 font-display text-6xl font-extrabold text-white sm:text-7xl">404</p>
      <h1 class="mt-3 font-display text-2xl font-extrabold text-white sm:text-3xl">We couldn't find that page</h1>
      <p class="mt-4 max-w-lg text-balance text-cream-100/80">
        The page you're looking for may have been moved, renamed, or no longer exists. Let's get you back on track.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="/" data-magnetic class="rounded-full bg-brand-red-600 px-6 py-3.5 text-sm font-bold text-white shadow-lift transition-transform hover:scale-105 hover:bg-brand-red-700">
          Back to homepage
        </a>
        <a href={site.phoneHref} class="text-sm font-bold text-white/90 hover:text-white">Call {site.phoneDisplay} →</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="text-center font-display text-xl font-bold text-navy-900">Or find what you need</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-animate-group>
      {verticals.map((v) => (
        <a href={`/${v.slug}/`} data-animate-item class="flex flex-col items-center gap-2 rounded-2xl border border-navy-900/10 bg-white p-6 text-center shadow-soft transition-all hover:-translate-y-1 hover:shadow-lift">
          <span class="font-display text-lg font-bold text-navy-900">{v.title}</span>
          <span class="text-sm text-ink-500">{v.tagline}</span>
        </a>
      ))}
    </div>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm font-semibold text-brand-red-600">
      <a href="/service-area/" class="hover:text-brand-red-700">Service Area</a>
      <a href="/coupons/" class="hover:text-brand-red-700">Coupons</a>
      <a href="/contact/" class="hover:text-brand-red-700">Contact</a>
      <a href="/schedule-now/" class="hover:text-brand-red-700">Schedule Now</a>
    </div>
  </section>
</BaseLayout>
