---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CTASection from "../../components/CTASection.astro";
import Testimonials from "../../components/home/Testimonials.astro";
import Icon from "../../components/Icon.astro";
import { locations } from "../../data/locations";
import { verticals } from "../../data/services";
import { site } from "../../data/site";
import { localBusinessSchema, breadcrumbSchema } from "../../lib/schema";

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { city: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props;
const path = `/${location.slug}/`;

// Deterministic "variant" index from the slug so neighboring city pages
// don't read as literal copy-paste clones of each other.
const seed = [...location.slug].reduce((a, c) => a + c.charCodeAt(0), 0);
const openers = [
  `${location.name} sits in ${location.county}, ${location.blurb}.`,
  `Homes in ${location.name} - ${location.blurb} - bring their own mix of plumbing, heating, cooling, and electrical needs.`,
  `${location.name} is one of the communities we've served longest across ${location.county}, home to ${location.blurb}.`,
];
const opener = openers[seed % openers.length];
---

<BaseLayout
  title={`Heating, Cooling, Plumbing & Electrical in ${location.name}, WA`}
  description={`Gene Johnson provides 24/7 heating, cooling, plumbing, and electrical service to ${location.name}, ${location.county}. Upfront pricing, licensed technicians, fix-it-right guarantee.`}
  path={path}
  schema={[
    localBusinessSchema({ areaServed: [location.name] }),
    breadcrumbSchema([
      { name: "Home", url: site.url },
      { name: "Service Area", url: `${site.url}/service-area/` },
      { name: location.name, url: `${site.url}${path}` },
    ]),
  ]}
>
  <PageHero
    eyebrow={`${location.county} · ${location.region}`}
    title={`Heating, Cooling, Plumbing & Electrical in ${location.name}, WA`}
    tagline={opener}
    breadcrumbs={[{ name: "Home", href: "/" }, { name: "Service Area", href: "/service-area/" }, { name: location.name }]}
  />

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl font-bold text-navy-900 sm:text-3xl">Services available in {location.name}</h2>
    <p class="mt-3 max-w-2xl text-ink-500">
      From routine maintenance to same-day emergency calls near {location.landmark}, our licensed technicians cover every trade under one roof.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-animate-group>
      {verticals.map((v) => (
        <a href={`/${v.slug}/`} data-animate-item class="group flex flex-col items-start gap-3 rounded-2xl border border-navy-900/10 bg-white p-6 shadow-soft transition-all hover:-translate-y-1 hover:shadow-lift">
          <span class="flex h-20 w-20 items-center justify-center rounded-xl bg-cream-100 group-hover:bg-navy-900">
            <Icon name={v.icon} class="h-12 w-12 text-navy-700 transition-colors duration-300 group-hover:text-accent-green-400" />
          </span>
          <span class="font-display font-bold text-navy-900">{v.title} in {location.name}</span>
          <span class="text-sm text-ink-500">{v.tagline}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-cream-100 py-16">
    <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8" data-animate>
      <h2 class="font-display text-2xl font-bold text-navy-900 sm:text-3xl">Why {location.name} calls Gene Johnson</h2>
      <p class="mt-4 text-ink-500">
        We've been a family-owned fixture in the greater Puget Sound area since {site.since}, which means our {location.name} customers get technicians who
        know the area's older housing stock, permitting quirks, and - around {location.landmark} - the exact kind of calls that come up most.
      </p>
    </div>
  </section>

  <Testimonials />
  <CTASection heading={`Need a technician in ${location.name} today?`} subheading={`Same-day and emergency appointments available across ${location.county}.`} />
</BaseLayout>
