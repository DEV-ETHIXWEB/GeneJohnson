---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../PageHero.astro";
import CTASection from "../CTASection.astro";
import Testimonials from "../home/Testimonials.astro";
import Icon from "../Icon.astro";
import IconShowcase from "../IconShowcase.astro";
import { site } from "../../data/site";
import type { Vertical } from "../../data/services";
import { serviceSchema, breadcrumbSchema, faqSchema } from "../../lib/schema";

export interface Props {
  vertical: Vertical;
}

const { vertical } = Astro.props;
const path = `/${vertical.slug}/`;

const showcaseCopy: Record<Vertical["slug"], { categories: string[]; title: string; subtitle: string }> = {
  plumbing: {
    categories: ["plumbing", "drainage"],
    title: "Every plumbing and drain problem, covered",
    subtitle: "From a single dripping faucet to a full sewer line replacement, this is the range of plumbing and drain work our licensed team handles.",
  },
  heating: {
    categories: ["heating"],
    title: "Every heating system, installed and serviced right",
    subtitle: "Furnaces, boilers, heat pumps, and radiant systems - one team that services every major heating technology in Puget Sound homes.",
  },
  cooling: {
    categories: ["cooling"],
    title: "Every way we keep your home cool",
    subtitle: "From full AC installs to ductless systems and indoor air quality, here's the full range of cooling solutions we install and service.",
  },
  electrical: {
    categories: ["electrical"],
    title: "Every electrical system, made safe and modern",
    subtitle: "Panels, wiring, lighting, EV chargers, and backup power - our licensed electricians handle every part of your home's electrical system.",
  },
};
const showcase = showcaseCopy[vertical.slug];
---

<BaseLayout
  title={`${vertical.title} Services in Seattle, WA`}
  description={`${vertical.tagline} ${vertical.intro}`}
  path={path}
  schema={[
    serviceSchema({ name: vertical.title, description: vertical.intro, url: `${site.url}${path}` }),
    breadcrumbSchema([
      { name: "Home", url: site.url },
      { name: vertical.title, url: `${site.url}${path}` },
    ]),
    faqSchema(vertical.faqs),
  ]}
>
  <PageHero
    eyebrow={vertical.title}
    title={vertical.tagline}
    tagline={vertical.intro}
    icon={vertical.icon}
    breadcrumbs={[{ name: "Home", href: "/" }, { name: vertical.title }]}
  />

  <section class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl space-y-5" data-animate>
      {vertical.overview.map((p) => (
        <p class="text-lg leading-relaxed text-ink-700">{p}</p>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl font-bold text-navy-900 sm:text-3xl">{vertical.title} services we offer</h2>
    <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3" data-animate-group>
      {vertical.subservices.map((s) => (
        <a
          href={`/${s.slug}/`}
          data-animate-item
          class="group flex aspect-square flex-col items-center justify-center gap-2 rounded-2xl border border-navy-900/10 bg-white p-3 text-center shadow-soft transition-all hover:-translate-y-1 hover:shadow-lift sm:aspect-auto sm:flex-row sm:justify-start sm:gap-4 sm:p-5 sm:text-left"
        >
          <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-cream-100 group-hover:bg-navy-900 sm:h-24 sm:w-24">
            <Icon name={s.icon} class="h-8 w-8 text-navy-700 transition-colors duration-300 group-hover:text-accent-green-400 sm:h-14 sm:w-14" />
          </span>
          <span class="line-clamp-2 text-xs font-semibold leading-snug text-navy-900 sm:line-clamp-none sm:text-base sm:leading-normal">{s.title}</span>
          <svg class="hidden h-4 w-4 text-ink-300 transition-transform group-hover:translate-x-1 group-hover:text-brand-red-600 sm:ml-auto sm:block" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-cream-100 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl font-bold text-navy-900 sm:text-3xl">Signs you need {vertical.title.toLowerCase()} service</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-animate-group>
        {vertical.signs.map((s) => (
          <div data-animate-item class="flex items-start gap-3 rounded-2xl bg-white p-5 shadow-soft">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-red-600" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.72-1.36 3.485 0l6.28 11.18c.75 1.334-.213 2.99-1.743 2.99H3.72c-1.53 0-2.492-1.656-1.743-2.99l6.28-11.18zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-.25-6.25a.75.75 0 00-1.5 0v3.5a.75.75 0 001.5 0v-3.5z" clip-rule="evenodd"/></svg>
            <p class="text-sm text-ink-700">{s}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <IconShowcase categories={showcase.categories} title={showcase.title} subtitle={showcase.subtitle} />

  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl font-bold text-navy-900 sm:text-3xl">{vertical.title} FAQs</h2>
    <div class="mt-6 divide-y divide-navy-900/10 rounded-2xl border border-navy-900/10 bg-white" data-animate-group>
      {vertical.faqs.map((f) => (
        <details data-animate-item class="group p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-navy-900">
            {f.q}
            <svg class="h-4 w-4 shrink-0 text-ink-500 transition-transform group-open:rotate-45" viewBox="0 0 20 20" fill="none"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-ink-500">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <Testimonials />
  <CTASection />
</BaseLayout>
