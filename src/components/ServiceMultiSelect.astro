---
// Icon-based multiple-choice service picker used on the hero quote form and
// Schedule Now. Real checkboxes (not JS-only state) so it's a working
// multi-select with no JavaScript, keyboard-navigable, and screen-reader
// friendly; Alpine only drives the "Other" text box reveal. Every checkbox
// shares `name="services"`, so a plain form POST submits every checked
// value as a repeated field - standard Formspree/HTML behavior, no custom
// serialization needed.
import { verticals } from "../data/services";
import Icon from "./Icon.astro";

export interface Props {
  idPrefix: string;
}

const { idPrefix } = Astro.props;
---

<div x-data="{ other: false }">
  <div class="grid grid-cols-2 gap-2">
    {verticals.map((v) => (
      <label class="group flex cursor-pointer items-center gap-2 rounded-xl border border-navy-900/15 px-3 py-2.5 text-sm font-medium text-ink-700 transition-colors has-checked:border-brand-red-600 has-checked:bg-brand-red-600/5 has-checked:text-brand-red-700 hover:bg-cream-100">
        <input type="checkbox" name="services" value={v.title} class="peer sr-only" />
        <Icon name={v.icon} class="h-5 w-5 shrink-0 text-navy-700 transition-colors peer-checked:text-brand-red-600" />
        <span>{v.title}</span>
      </label>
    ))}
    <label class="group flex cursor-pointer items-center gap-2 rounded-xl border border-navy-900/15 px-3 py-2.5 text-sm font-medium text-ink-700 transition-colors has-checked:border-brand-red-600 has-checked:bg-brand-red-600/5 has-checked:text-brand-red-700 hover:bg-cream-100">
      <input type="checkbox" name="services" value="Other" class="peer sr-only" x-model="other" />
      <svg class="h-5 w-5 shrink-0 text-navy-700 transition-colors peer-checked:text-brand-red-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" stroke-linecap="round" stroke-linejoin="round"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>Other</span>
    </label>
  </div>

  <div x-show="other" x-cloak x-transition class="mt-2">
    <label class="sr-only" for={`${idPrefix}-service-other`}>Tell us what you need</label>
    <input
      id={`${idPrefix}-service-other`}
      name="service_other"
      placeholder="Briefly, what do you need help with?"
      class="w-full rounded-xl border border-navy-900/15 px-4 py-2.5 text-sm focus:border-brand-red-500 focus:outline-none"
    />
  </div>
</div>
