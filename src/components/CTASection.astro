---
import { site } from "../data/site";

export interface Props {
  heading?: string;
  subheading?: string;
}

const {
  heading = "Can't wait? Emergencies happen.",
  subheading = "Our team is on call 24/7 across the greater Puget Sound area.",
} = Astro.props;
---

<section class="relative overflow-hidden bg-brand-red-600 py-16">
  <div class="bg-grid pointer-events-none absolute inset-0 opacity-10"></div>
  <div class="relative mx-auto flex max-w-5xl flex-col items-center gap-6 px-4 text-center sm:px-6 lg:px-8" data-animate>
    <h2 class="font-display text-3xl font-extrabold text-white sm:text-4xl">{heading}</h2>
    <p class="max-w-xl text-white/85">{subheading}</p>
    <a
      href={site.phoneHref}
      data-magnetic
      class="inline-flex items-center gap-3 rounded-full bg-white px-8 py-4 font-display text-xl font-extrabold text-brand-red-600 shadow-lift transition-transform hover:scale-105"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      {site.phoneDisplay}
    </a>
  </div>
</section>
