---
import { site } from "../data/site";
---

<a
  href={site.phoneHref}
  data-magnetic
  class="group relative flex items-center gap-4 overflow-hidden rounded-2xl bg-brand-red-600 p-5 shadow-lift transition-transform hover:scale-[1.015]"
>
  <div class="bg-grid pointer-events-none absolute inset-0 opacity-10"></div>
  <span class="relative flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-white/15 text-white">
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
  </span>
  <span class="relative flex flex-1 flex-col">
    <span class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest text-white/80">
      <span class="relative flex h-1.5 w-1.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white opacity-75"></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-white"></span>
      </span>
      Call now - 24/7 emergency service
    </span>
    <span class="font-display text-2xl font-extrabold text-white">{site.phoneDisplay}</span>
  </span>
  <svg class="relative h-5 w-5 shrink-0 text-white/70 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
</a>
