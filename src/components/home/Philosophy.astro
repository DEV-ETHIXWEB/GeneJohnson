---
const benefits = [
  "Best value service in the Puget Sound area",
  "On-time arrival guarantee",
  "No mess left behind after the job",
  "A team that truly cares about your safety and comfort",
  "Fixed-right guarantee on every repair",
  "Upfront pricing before any work begins",
  "Friendly follow-up calls for peace of mind",
  "Multiple service options, never ultimatums",
];
---

<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="overflow-hidden rounded-[2.5rem] bg-navy-900 px-6 py-16 sm:px-16">
    <div class="mx-auto max-w-2xl text-center" data-animate>
      <p class="text-sm font-bold uppercase tracking-widest text-brand-red-400">Within your budget</p>
      <h2 class="mt-3 font-display text-3xl font-extrabold text-white sm:text-4xl">Great service shouldn't come with a catch</h2>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-animate-group>
      {benefits.map((b) => (
        <div data-animate-item class="flex items-start gap-3 rounded-2xl bg-white/5 p-5 transition-transform duration-300 hover:-translate-y-1.5">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent-green-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.4 7.4a1 1 0 01-1.4 0L3.3 9.5a1 1 0 111.4-1.4l3.9 3.9 6.7-6.7a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
          <p class="text-sm text-cream-100/85">{b}</p>
        </div>
      ))}
    </div>
  </div>
</section>
