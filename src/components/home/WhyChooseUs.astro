---
import { Image } from "astro:assets";
import technician from "../../assets/images/team-fleet/friendly-technician.webp";
import { getIcon3d, fitDims } from "../../lib/icons3d";

const points = [
  { icon: getIcon3d("trust", "Family Owned"), title: "Family Owned & Operated", text: `Operating since 1976, we back every job with the guarantee of a company that plans to be here for another 50 years.` },
  { icon: getIcon3d("trust", "Warranty"), title: "Quality Workmanship", text: "From a dripping faucet to a full sewer replacement, we handle complex issues with trusted, code-compliant results, backed by a workmanship warranty." },
  { icon: getIcon3d("trust", "Free Diagnostics"), title: "Customer Education", text: "We explain every option in plain language and answer every concern before we start - no pressure, no surprises." },
  { icon: getIcon3d("trust", "Upfront Pricing"), title: "Upfront Pricing", text: "You'll always see the price before we start - no hourly surprises, no mystery invoice at the end." },
];

const badges = [
  { icon: getIcon3d("trust", "24/7 Availability"), title: "Emergency Dispatch, Any Hour", text: "On call around the clock for the emergencies that can't wait." },
  { icon: getIcon3d("trust", "Certified & Awarded"), title: "Certified & Award-Winning", text: "HomeAdvisor Elite Service recognition and BBB accreditation." },
  { icon: getIcon3d("trust", "Insured"), title: "Fully Licensed & Insured", text: "Licensed, bonded, and insured on every job, every time." },
];

const since1976 = getIcon3d("trust", "Since 1976");
---

<section class="relative overflow-hidden bg-cream-100 py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
      <div data-animate class="relative lg:sticky lg:top-28">
        <div class="aspect-[4/5] overflow-hidden rounded-[2rem] shadow-lift sm:aspect-[5/4] lg:aspect-[4/5]">
          <Image src={technician} alt="Friendly Gene Johnson technician" width={680} height={520} densities={[1, 2]} quality={88} class="h-full w-full object-cover" />
        </div>
        <div class="absolute -right-4 -top-6 flex items-center gap-3 rounded-2xl bg-navy-950 p-5 text-white shadow-lift sm:-right-6">
          <Image src={since1976.src} alt={since1976.label} {...fitDims(since1976, 72)} class="h-9 w-9 object-contain" />
          <div>
            <p class="font-display text-3xl font-extrabold">49+</p>
            <p class="text-xs uppercase tracking-wide text-cream-100/70">Years of trust</p>
          </div>
        </div>
      </div>

      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-brand-red-600">Why choose us</p>
        <h2 class="mt-3 font-display text-3xl font-extrabold text-navy-900 sm:text-4xl">Comfort and safety you can actually count on</h2>

        <div class="mt-8 space-y-6" data-animate-group>
          {points.map((p) => (
            <div data-animate-item class="flex gap-4">
              <span class="flex h-24 w-24 shrink-0 items-center justify-center rounded-xl bg-white shadow-soft">
                <Image src={p.icon.src} alt={p.icon.label} {...fitDims(p.icon, 112)} class="h-14 w-14 object-contain" />
              </span>
              <div>
                <h3 class="font-display text-lg font-bold text-navy-900">{p.title}</h3>
                <p class="mt-1 text-sm text-ink-500">{p.text}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-3" data-animate-group>
          {badges.map((b) => (
            <div data-animate-item class="flex flex-col gap-3 rounded-2xl border border-navy-900/10 bg-white p-5">
              <Image src={b.icon.src} alt={b.icon.label} {...fitDims(b.icon, 96)} class="h-10 w-10 object-contain" />
              <div>
                <h3 class="font-display text-sm font-bold text-navy-900">{b.title}</h3>
                <p class="mt-1 text-xs leading-relaxed text-ink-500">{b.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
