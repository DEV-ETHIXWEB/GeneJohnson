---
import { verticals } from "../../data/services";
import Icon from "../Icon.astro";

const accents: Record<string, string> = {
  red: "from-brand-red-600 to-brand-red-500",
  navy: "from-navy-800 to-navy-600",
};

const hoverAccents: Record<string, string> = {
  red: "hover:border-brand-red-600 hover:bg-brand-red-600",
  navy: "hover:border-navy-900 hover:bg-navy-900",
};
---

<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl text-center" data-animate>
    <p class="text-sm font-bold uppercase tracking-widest text-brand-red-600">What we do</p>
    <h2 class="mt-3 font-display text-3xl font-extrabold text-navy-900 sm:text-4xl">One call for everything your home needs</h2>
    <p class="mt-4 text-ink-500">Four licensed trades, one family-owned company you can call at any hour.</p>
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-animate-group>
    {verticals.map((v) => (
      <a
        href={`/${v.slug}/`}
        data-animate-item
        class:list={[
          "group relative flex flex-col overflow-hidden rounded-3xl border border-navy-900/10 bg-white p-7 shadow-soft transition-all duration-300 hover:-translate-y-2 hover:shadow-lift",
          hoverAccents[v.color],
        ]}
      >
        <div class={`absolute left-8 right-8 top-0 h-1.5 rounded-full bg-gradient-to-r ${accents[v.color]} transition-opacity duration-300 group-hover:opacity-0`}></div>
        <span class="flex h-28 w-28 items-center justify-center rounded-2xl bg-cream-100 transition-colors duration-300 group-hover:bg-white/10">
          <Icon name={v.icon} class="h-[4.5rem] w-[4.5rem] text-navy-700 transition-all duration-300 group-hover:scale-110 group-hover:text-white" />
        </span>
        <h3 class="mt-5 font-display text-xl font-bold text-navy-900 transition-colors duration-300 group-hover:text-white">{v.title}</h3>
        <p class="mt-2 flex-1 text-sm text-ink-500 transition-colors duration-300 group-hover:text-white/70">{v.tagline}</p>
        <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-red-600 transition-colors duration-300 group-hover:text-accent-green-500">
          Explore {v.title}
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </a>
    ))}
  </div>
</section>
