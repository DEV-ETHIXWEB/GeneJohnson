---
import { site } from "../../data/site";

const words = ["Clean.", "Experienced.", "Professional."];
---

<section class="relative isolate min-h-[92vh] overflow-hidden bg-navy-950">
  <div class="absolute inset-0 -z-20">
    <video
      class="h-full w-full object-cover motion-reduce:hidden"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/videos/hero-seattle-poster.jpg"
      aria-hidden="true"
    >
      <source src="/videos/hero-seattle-mobile.mp4" media="(max-width: 767px)" type="video/mp4" />
      <source src="/videos/hero-seattle.mp4" type="video/mp4" />
    </video>
    <img
      src="/videos/hero-seattle-poster.jpg"
      alt=""
      aria-hidden="true"
      class="hidden h-full w-full object-cover motion-reduce:block"
    />
  </div>

  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-navy-950/85 via-navy-950/70 to-navy-950"></div>
  <div class="bg-grid pointer-events-none absolute inset-0 -z-10 opacity-20"></div>
  <div
    data-parallax="0.15"
    class="pointer-events-none absolute -right-32 -top-32 -z-10 h-[36rem] w-[36rem] rounded-full bg-brand-red-600/20 blur-3xl"
  ></div>

  <div class="relative mx-auto flex min-h-[92vh] max-w-7xl flex-col justify-center px-4 py-24 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p data-hero-fade class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-cream-100">
        Serving the Puget Sound since {site.since}
      </p>

      <h1 data-hero-title class="font-display text-4xl font-extrabold leading-[1.05] text-white sm:text-5xl lg:text-6xl" style="perspective: 800px;">
        {words.map((w) => (
          <span class="mr-3 inline-block overflow-hidden">
            <span data-word class="inline-block">{w}</span>
          </span>
        ))}
        <span class="block text-gradient-red">Since 1976.</span>
      </h1>

      <p data-hero-fade class="mt-6 max-w-lg text-balance text-lg text-cream-100/80">
        Heating, cooling, plumbing &amp; electrical service for the greater Seattle area - family owned, upfront pricing, and a fix-it-right guarantee on every visit.
      </p>

      <div data-hero-fade class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/schedule-now/"
          data-magnetic
          class="rounded-full bg-brand-red-600 px-7 py-4 text-sm font-bold text-white shadow-lift transition-transform hover:scale-105 hover:bg-brand-red-700"
        >
          Request Service Now
        </a>
        <a href={site.phoneHref} class="flex items-center gap-2 text-sm font-bold text-white/90 hover:text-white">
          <span class="flex h-11 w-11 items-center justify-center rounded-full border border-white/20 bg-white/5">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </span>
          Call {site.phoneDisplay}
        </a>
      </div>

      <div data-hero-fade class="mt-10 flex items-center gap-6 text-cream-100/70">
        <div>
          <p class="font-display text-2xl font-bold text-white" data-count-to="2400">2,400</p>
          <p class="text-xs uppercase tracking-wide">5-star reviews</p>
        </div>
        <div class="h-8 w-px bg-white/15"></div>
        <div>
          <p class="font-display text-2xl font-bold text-white"><span data-count-to="49">49</span>+</p>
          <p class="text-xs uppercase tracking-wide">Years in business</p>
        </div>
        <div class="h-8 w-px bg-white/15"></div>
        <div>
          <p class="font-display text-2xl font-bold text-white">24/7</p>
          <p class="text-xs uppercase tracking-wide">Emergency service</p>
        </div>
      </div>
    </div>

    <div data-animate class="absolute bottom-10 right-4 hidden rounded-2xl border border-white/10 bg-white/95 p-4 shadow-lift backdrop-blur sm:right-6 md:block lg:right-8">
      <p class="font-display text-3xl font-extrabold text-navy-900">4.8<span class="text-brand-red-600">★</span></p>
      <p class="text-xs font-medium text-ink-500">Average rating &middot; 2,400+ reviews</p>
    </div>
  </div>
</section>
