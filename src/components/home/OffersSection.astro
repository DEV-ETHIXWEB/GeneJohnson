---
import { offers } from "../../data/offers";
import CouponCard from "../CouponCard.astro";
---

<section class="bg-navy-950 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4" data-animate>
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-brand-red-400">Current offers</p>
        <h2 class="mt-3 font-display text-3xl font-extrabold text-white sm:text-4xl">Savings that actually add up</h2>
      </div>
      <a href="/coupons/" class="text-sm font-semibold text-white/80 hover:text-white">View all coupons →</a>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2" data-animate-group>
      {offers.slice(0, 4).map((o) => (
        <div data-animate-item>
          <CouponCard title={o.title} detail={o.detail} icon={o.icon} code={o.code} dark notchColor="#14123a" />
        </div>
      ))}
    </div>
  </div>
</section>
