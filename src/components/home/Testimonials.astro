---
import { testimonials } from "../../data/testimonials";
---

<section class="bg-cream-100 py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center" data-animate>
      <p class="text-sm font-bold uppercase tracking-widest text-brand-red-600">Reviews</p>
      <h2 class="mt-3 font-display text-3xl font-extrabold text-navy-900 sm:text-4xl">2,400+ five-star reviews and counting</h2>
    </div>
  </div>

  <div
    class="marquee-viewport mt-12 overflow-hidden"
    style="mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);"
  >
    <div class="flex w-max shrink-0 animate-marquee-reverse items-stretch gap-6 px-4" data-marquee-track>
      {testimonials.map((t) => (
        <figure class="flex w-[22rem] shrink-0 flex-col rounded-3xl border border-navy-900/10 bg-white p-7 shadow-soft transition-shadow hover:shadow-lift">
          <div class="flex gap-0.5 text-brand-red-500">
            {Array.from({ length: t.rating }).map(() => (
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.2-5.4 3.2 1.3-6-4.6-4.1 6.1-.6z"/></svg>
            ))}
          </div>
          <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-ink-700">"{t.text}"</blockquote>
          <figcaption class="mt-5 border-t border-navy-900/5 pt-4">
            <p class="font-display text-sm font-bold text-navy-900">{t.name}</p>
            <p class="text-xs text-ink-500">{t.location} &middot; {t.service}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mt-10 text-center">
      <a href="/reviews/" class="text-sm font-semibold text-brand-red-600 hover:text-brand-red-700">Read all reviews →</a>
    </div>
  </div>
</section>
