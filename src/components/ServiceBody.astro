---
import { Image } from "astro:assets";
import { getImage } from "../lib/images";
import Icon from "./Icon.astro";
import CallNowCard from "./CallNowCard.astro";
import { site } from "../data/site";

export interface Props {
  intro: string[];
  highlights: string[];
  faqs?: { q: string; a: string }[];
  image: string;
  icon: string;
  related: { slug: string; title: string; icon: string }[];
}

const { intro, highlights, faqs = [], image, icon, related } = Astro.props;

// Varied phrasing so the repeated phone link under each paragraph reads as
// a natural nudge rather than the same CTA copy-pasted four times in a row.
const phoneCtas = [
  "Questions? Call",
  "Ready to schedule? Call",
  "Need it handled today? Call",
  "Talk to a real person - call",
];
---

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="grid gap-12 lg:grid-cols-2">
    <div data-animate>
      <span class="flex h-28 w-28 items-center justify-center rounded-2xl bg-cream-100">
        <Icon name={icon} class="h-[4.5rem] w-[4.5rem] text-navy-700" />
      </span>

      <div class="mt-6 space-y-6">
        {intro.map((paragraph, i) => (
          <div>
            <p class="text-lg leading-relaxed text-ink-700">{paragraph}</p>
            <a href={site.phoneHref} class="mt-2 inline-flex items-center gap-1.5 text-xs font-semibold text-ink-500 transition-colors hover:text-brand-red-600">
              <svg class="h-3.5 w-3.5 text-brand-red-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              {phoneCtas[i % phoneCtas.length]} {site.phoneDisplay}
            </a>
          </div>
        ))}
      </div>

      <ul class="mt-8 space-y-3" data-animate-group>
        {highlights.map((h) => (
          <li data-animate-item class="flex items-start gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent-green-600" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.4 7.4a1 1 0 01-1.4 0L3.3 9.5a1 1 0 111.4-1.4l3.9 3.9 6.7-6.7a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
            <span class="text-sm text-ink-700">{h}</span>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <div class="lg:sticky lg:top-28">
        <div data-animate>
          <div class="overflow-hidden rounded-[2rem] shadow-lift">
            <Image src={getImage(image)} alt={intro[0].slice(0, 60)} width={640} height={480} densities={[1, 2]} quality={88} class="h-full w-full object-cover" />
          </div>

          <div class="mt-5">
            <CallNowCard />
          </div>
        </div>
      </div>
    </div>
  </div>

  {faqs.length > 0 && (
    <div class="mx-auto mt-16 max-w-3xl" data-animate-group>
      <h2 class="font-display text-2xl font-bold text-navy-900">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-navy-900/10 rounded-2xl border border-navy-900/10 bg-white">
        {faqs.map((f) => (
          <details data-animate-item class="group p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-navy-900">
              {f.q}
              <svg class="h-4 w-4 shrink-0 text-ink-500 transition-transform group-open:rotate-45" viewBox="0 0 20 20" fill="none"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink-500">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  )}

  {related.length > 0 && (
    <div class="mt-16">
      <h2 class="font-display text-2xl font-bold text-navy-900">Related services</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-animate-group>
        {related.slice(0, 6).map((r) => (
          <a href={`/${r.slug}/`} data-animate-item class="group flex items-center gap-4 rounded-2xl border border-navy-900/10 bg-white p-5 transition-colors hover:border-brand-red-200 hover:bg-cream-100">
            <span class="flex h-20 w-20 shrink-0 items-center justify-center rounded-xl bg-cream-100 group-hover:bg-white">
              <Icon name={r.icon} class="h-12 w-12 text-navy-700 transition-colors duration-300 group-hover:text-brand-red-600" />
            </span>
            <span class="text-sm font-semibold text-navy-900">{r.title}</span>
          </a>
        ))}
      </div>
    </div>
  )}
</section>
