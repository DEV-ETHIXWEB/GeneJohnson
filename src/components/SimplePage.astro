---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "./PageHero.astro";
import CTASection from "./CTASection.astro";
import { site } from "../data/site";
import { breadcrumbSchema } from "../lib/schema";

export interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow?: string;
  tagline?: string;
  breadcrumbs: { name: string; href?: string }[];
  hideCta?: boolean;
  schema?: (object | null)[];
  icon?: string;
}

const { title, description, path, eyebrow, tagline, breadcrumbs, hideCta = false, schema = [], icon } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schema={[breadcrumbSchema(breadcrumbs.map((b) => ({ name: b.name, url: b.href ? `${site.url}${b.href}` : `${site.url}${path}` }))), ...schema]}
>
  <PageHero eyebrow={eyebrow} title={title} tagline={tagline} breadcrumbs={breadcrumbs} icon={icon} />
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="prose-content" data-animate>
      <slot />
    </div>
  </div>
  {!hideCta && <CTASection />}
</BaseLayout>

<style>
  .prose-content :global(h2) {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--color-navy-900);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .prose-content :global(p) {
    color: var(--color-ink-700);
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }
  .prose-content :global(ul) {
    margin: 1.25rem 0;
    padding-left: 1.25rem;
    list-style: disc;
    color: var(--color-ink-700);
  }
  .prose-content :global(li) {
    margin-bottom: 0.5rem;
  }
  .prose-content :global(a) {
    color: var(--color-brand-red-600);
    font-weight: 600;
  }
</style>
