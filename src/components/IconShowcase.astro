---
import { Image } from "astro:assets";
import { getIcons3d, fitDims } from "../lib/icons3d";

export interface Props {
  categories: string[];
  eyebrow?: string;
  title: string;
  subtitle?: string;
}

const { categories, eyebrow = "What's included", title, subtitle } = Astro.props;
const items = getIcons3d(categories);
---

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl text-center" data-animate>
    <p class="text-sm font-bold uppercase tracking-widest text-brand-red-600">{eyebrow}</p>
    <h2 class="mt-3 font-display text-2xl font-bold text-navy-900 sm:text-3xl">{title}</h2>
    {subtitle && <p class="mt-3 text-ink-500">{subtitle}</p>}
  </div>

  <div class="mt-10 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4" data-animate-group>
    {items.map((item) => (
      <div data-animate-item class="flex flex-col items-center gap-3 rounded-2xl border border-navy-900/10 bg-white p-5 text-center shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-lift">
        <Image src={item.src} alt={item.label} {...fitDims(item, 160)} densities={[1, 2]} class="h-20 w-20 object-contain" />
        <span class="text-sm font-semibold text-navy-900">{item.label}</span>
      </div>
    ))}
  </div>
</section>
