---
import { site } from "../data/site";
---

<div class="bg-navy-950 text-cream-100 text-xs sm:text-sm">
  <div class="mx-auto flex max-w-7xl items-center justify-center px-4 py-2 sm:px-6 lg:px-8">
    <p class="flex items-center gap-2 font-medium">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-red-500 opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-red-500"></span>
      </span>
      24/7 Emergency Service &middot; Family Owned Since {site.since}
    </p>
  </div>
</div>
