---
import { Image } from "astro:assets";
import logo from "../assets/images/logos/logo-top.webp";
import { site } from "../data/site";
import { verticals } from "../data/services";
import Icon from "./Icon.astro";
---

<header
  x-data="{ menu: null, mobile: false }"
  class="sticky top-0 z-50 border-b border-navy-900/5 bg-cream-50/90 backdrop-blur-lg"
  @keydown.escape.window="menu = null; mobile = false"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2 shrink-0" data-magnetic>
      <Image src={logo} alt={site.name} width={180} height={104} densities={[1, 2, 3, 4]} quality={100} class="h-[4.2rem] w-auto sm:h-[4.8rem]" />
    </a>

    <nav class="hidden items-center gap-1 xl:flex" @mouseleave="menu = null">
      {verticals.map((v) => (
        <div class="relative">
          <button
            class="group flex items-center gap-1.5 whitespace-nowrap rounded-full px-3 py-2 text-sm font-semibold text-navy-900 transition-colors hover:bg-navy-900/5"
            @mouseenter={`menu = '${v.slug}'`}
            @click={`menu = menu === '${v.slug}' ? null : '${v.slug}'`}
          >
            <Icon name={v.icon} class="h-6 w-6 text-navy-700 transition-colors duration-300 group-hover:text-brand-red-600" />
            {v.title}
            <svg class="h-3.5 w-3.5 opacity-50" viewBox="0 0 12 8" fill="none"><path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>

          <div
            x-show={`menu === '${v.slug}'`}
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 translate-y-1"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-cloak
            class="absolute left-1/2 top-full w-[36rem] -translate-x-1/2 pt-3"
          >
            <div class="grid grid-cols-2 gap-1 rounded-2xl border border-navy-900/5 bg-white p-4 shadow-lift">
              {v.subservices.slice(0, 10).map((s) => (
                <a href={`/${s.slug}/`} class="group flex items-center gap-3 rounded-xl px-3 py-2.5 transition-colors hover:bg-cream-100">
                  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-cream-100 group-hover:bg-white">
                    <Icon name={s.icon} class="h-8 w-8 text-navy-700 transition-colors duration-300 group-hover:text-brand-red-600" />
                  </span>
                  <span class="text-sm font-medium text-ink-700 group-hover:text-navy-900">{s.title}</span>
                </a>
              ))}
            </div>
            <a href={`/${v.slug}/`} class="mt-2 block rounded-2xl border border-navy-900/5 bg-navy-900 px-4 py-3 text-center text-sm font-semibold text-white transition-colors hover:bg-navy-800">
              View all {v.title} services →
            </a>
          </div>
        </div>
      ))}

      <a href="/coupons/" class="whitespace-nowrap rounded-full px-3 py-2 text-sm font-semibold text-navy-900 transition-colors hover:bg-navy-900/5">Coupons</a>
      <a href="/about-us/" class="whitespace-nowrap rounded-full px-3 py-2 text-sm font-semibold text-navy-900 transition-colors hover:bg-navy-900/5">About Us</a>
      <a href="/contact/" class="whitespace-nowrap rounded-full px-3 py-2 text-sm font-semibold text-navy-900 transition-colors hover:bg-navy-900/5">Contact</a>
    </nav>

    <div class="hidden items-center gap-3 xl:flex">
      <a
        href={site.phoneHref}
        class="group flex h-12 shrink-0 items-center gap-2 whitespace-nowrap rounded-full border border-navy-900/10 bg-white px-3 shadow-soft transition-colors hover:border-brand-red-200"
      >
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-red-600/10 text-brand-red-600 transition-colors group-hover:bg-brand-red-600 group-hover:text-white">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </span>
        <span class="flex flex-col leading-none">
          <span class="text-[0.65rem] font-semibold uppercase tracking-wide text-ink-500">Call anytime</span>
          <span class="font-display text-base font-extrabold text-brand-red-600">{site.phoneDisplay}</span>
        </span>
      </a>
      <a
        href="/schedule-now/"
        data-magnetic
        class="flex h-12 shrink-0 items-center whitespace-nowrap rounded-full bg-brand-red-600 px-5 text-sm font-bold text-white shadow-soft transition-transform hover:scale-[1.03] hover:bg-brand-red-700"
      >
        Book Online Now
      </a>
    </div>

    <button
      class="flex h-11 w-11 items-center justify-center rounded-full border border-navy-900/10 bg-white text-navy-900 shadow-soft transition-colors hover:border-brand-red-200 xl:hidden"
      @click="mobile = !mobile"
      aria-label="Toggle menu"
    >
      <svg x-show="!mobile" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
      <svg x-show="mobile" x-cloak class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </div>

  <div
    x-show="mobile"
    x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    class="border-t border-navy-900/5 bg-white px-4 py-4 xl:hidden"
  >
    <div class="flex flex-col gap-1">
      {verticals.map((v) => (
        <a href={`/${v.slug}/`} class="group flex items-center gap-3 rounded-xl px-3 py-3 font-semibold text-navy-900 hover:bg-cream-100">
          <Icon name={v.icon} class="h-7 w-7 text-navy-700 transition-colors duration-300 group-hover:text-brand-red-600" />
          {v.title}
        </a>
      ))}
      <a href="/coupons/" class="rounded-xl px-3 py-3 font-semibold text-navy-900 hover:bg-cream-100">Coupons</a>
      <a href="/about-us/" class="rounded-xl px-3 py-3 font-semibold text-navy-900 hover:bg-cream-100">About Us</a>
      <a href="/reviews/" class="rounded-xl px-3 py-3 font-semibold text-navy-900 hover:bg-cream-100">Reviews</a>
      <a href="/contact/" class="rounded-xl px-3 py-3 font-semibold text-navy-900 hover:bg-cream-100">Contact</a>
    </div>
    <a href="/schedule-now/" class="mt-3 block rounded-full bg-brand-red-600 px-5 py-3 text-center text-sm font-bold text-white">Book Online Now</a>
    <a href={site.phoneHref} class="mt-3 block text-center text-sm font-bold text-navy-900">Call {site.phoneDisplay}</a>
  </div>
</header>
