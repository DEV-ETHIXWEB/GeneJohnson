---
import { Image } from "astro:assets";
import logo from "../assets/images/logos/logo-bottom.webp";
import { site } from "../data/site";
import { verticals } from "../data/services";
import badgeBbb from "../assets/images/badges/bbb.webp";
import badgeElite from "../assets/images/badges/homeadvisor-elite-1.webp";
import badgeTi from "../assets/images/badges/ti-verified.webp";
---

<footer class="bg-navy-950 text-cream-200">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:gap-10">
      <div class="col-span-2 lg:col-span-1">
        <Image src={logo} alt={site.name} width={264} height={218} densities={[1, 2, 3, 4]} quality={100} class="h-[7.2rem] w-auto" />
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-cream-200/70">
          Family owned and operated since {site.since}. Heating, cooling, plumbing, and electrical service across the greater Puget Sound area.
        </p>
        <a href={site.phoneHref} class="mt-4 inline-block font-display text-2xl font-bold text-white hover:text-brand-red-400">
          {site.phoneDisplay}
        </a>
        <p class="text-xs uppercase tracking-wider text-cream-200/70">24/7 emergency service</p>

        <div class="mt-6 flex items-center gap-5">
          <Image src={badgeBbb} alt="BBB Accredited Business" width={234} height={83} densities={[1, 2, 3]} quality={95} class="h-10 w-auto opacity-90" />
          <Image src={badgeElite} alt="HomeAdvisor Elite Service" width={128} height={127} densities={[1, 2, 3]} quality={95} class="h-14 w-auto opacity-90" />
          <Image src={badgeTi} alt="Trust Index Verified" width={150} height={150} densities={[1, 2, 3]} quality={95} class="h-12 w-auto opacity-90" />
        </div>
      </div>

      <div>
        <h3 class="font-display text-sm font-bold uppercase tracking-wider text-white">Services</h3>
        <ul class="mt-4 space-y-2.5 text-sm text-cream-200/70">
          {verticals.map((v) => (
            <li><a href={`/${v.slug}/`} class="hover:text-white transition-colors">{v.title}</a></li>
          ))}
          <li><a href="/service-area/" class="hover:text-white transition-colors">Service Area</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm font-bold uppercase tracking-wider text-white">Company</h3>
        <ul class="mt-4 space-y-2.5 text-sm text-cream-200/70">
          <li><a href="/about-us/" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="/about-us/careers/" class="hover:text-white transition-colors">Careers</a></li>
          <li><a href="/about-us/financing/" class="hover:text-white transition-colors">Financing</a></li>
          <li><a href="/reviews/" class="hover:text-white transition-colors">Reviews</a></li>
          <li><a href="/coupons/" class="hover:text-white transition-colors">Coupons</a></li>
          <li><a href="/video-blog/" class="hover:text-white transition-colors">Blog</a></li>
          <li><a href="/contact/" class="hover:text-white transition-colors">Contact</a></li>
        </ul>
      </div>

      <div class="col-span-2 lg:col-span-1">
        <h3 class="font-display text-sm font-bold uppercase tracking-wider text-white">Legal & Licenses</h3>
        <ul class="mt-4 space-y-2.5 text-sm text-cream-200/70">
          {site.licenses.map((l) => <li>{l.label} {l.value}</li>)}
        </ul>
        <ul class="mt-4 space-y-2.5 text-sm text-cream-200/70">
          <li><a href="/terms-and-conditions/" class="hover:text-white transition-colors">Terms & Conditions</a></li>
          <li><a href="/cookie-policy-eu/" class="hover:text-white transition-colors">Cookie Policy</a></li>
          <li><a href="/accessibility/" class="hover:text-white transition-colors">ADA Accessibility</a></li>
          <li><a href="/sitemap/" class="hover:text-white transition-colors">Sitemap</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-white/10 pt-8 text-xs text-cream-200/70">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p>&copy; {new Date().getFullYear()} {site.name}. All rights reserved.</p>
        <div class="flex flex-wrap gap-x-6 gap-y-1">
          {site.locationsList.map((loc) => <span>{loc}</span>)}
        </div>
      </div>
    </div>
  </div>
</footer>
