---
import Icon from "./Icon.astro";

export interface Props {
  title: string;
  detail: string;
  icon: string;
  code: string;
  dark?: boolean;
  notchColor?: string;
}

const { title, detail, icon, code, dark = false, notchColor } = Astro.props;

// The two semicircle "punch holes" only read correctly if their fill matches
// whatever sits directly behind the card, so callers on a non-default
// background (e.g. the navy homepage section) pass their own color.
const notch = notchColor ?? (dark ? "#1c1a4d" : "#f4f5f9");
---

<div
  class:list={[
    "coupon-card group relative flex overflow-hidden rounded-2xl border-2 border-dashed shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-lift",
    dark ? "border-white/20 bg-white/[0.04]" : "border-navy-900/15 bg-white",
  ]}
>
  <div
    class:list={[
      "relative flex w-28 shrink-0 flex-col items-center justify-center gap-3 p-4 text-center sm:w-32",
      dark ? "bg-white/5" : "bg-navy-900",
    ]}
  >
    <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/10">
      <Icon name={icon} class="h-10 w-10 text-white transition-transform duration-300 group-hover:scale-110" />
    </span>
    <span class="text-[0.6rem] font-bold uppercase tracking-widest text-white/60">Gene Johnson</span>

    <span
      class="notch pointer-events-none absolute -right-3 -top-3 h-6 w-6 rounded-full"
      style={{ background: notch }}
    ></span>
    <span
      class="notch pointer-events-none absolute -bottom-3 -right-3 h-6 w-6 rounded-full"
      style={{ background: notch }}
    ></span>
  </div>

  <div class:list={["flex flex-1 flex-col justify-center gap-1.5 border-l-2 border-dashed p-5", dark ? "border-white/20" : "border-navy-900/15"]}>
    <h3 class:list={["font-display text-lg font-extrabold leading-snug", dark ? "text-white" : "text-navy-900"]}>{title}</h3>
    <p class:list={["text-sm", dark ? "text-cream-100/60" : "text-ink-500"]}>{detail}</p>
    <div class="mt-3 flex items-center justify-between gap-3">
      <span class:list={["font-mono text-[0.7rem] tracking-widest", dark ? "text-white/40" : "text-ink-300"]}>CODE: {code}</span>
      <a href="/schedule-now/" class:list={["text-sm font-bold", dark ? "text-brand-red-400 hover:text-brand-red-300" : "text-brand-red-600 hover:text-brand-red-700"]}>
        Claim →
      </a>
    </div>
  </div>
</div>
