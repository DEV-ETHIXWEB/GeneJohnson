---
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/inter";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EmergencyBar from "../components/EmergencyBar.astro";
import AccessibilityWidget from "../components/AccessibilityWidget.astro";
import ChatWidget from "../components/ChatWidget.astro";
import { localBusinessSchema } from "../lib/schema";

export interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  noindex?: boolean;
  schema?: (object | null)[];
}

const { title, description, path, image, noindex, schema = [] } = Astro.props;

// Auto-noindex any non-production build so preview/staging deploys never get
// crawled, without relying on every page to opt in manually. CONTEXT is
// Netlify's deploy-context env var (production/deploy-preview/branch-deploy);
// VERCEL_ENV is Vercel's equivalent (production/preview/development). Neither
// is set locally, so `astro dev` and local builds are unaffected.
const isNonProductionDeploy =
  (typeof process !== "undefined" &&
    ((process.env.CONTEXT && process.env.CONTEXT !== "production") ||
      (process.env.VERCEL_ENV && process.env.VERCEL_ENV !== "production"))) ||
  false;
const effectiveNoindex = noindex || isNonProductionDeploy;

// Every page gets a LocalBusiness block for free - except pages that already
// pass their own (city and service-area pages add a more specific `areaServed`
// variant). Auto-adding on top of that produced two HomeAndConstructionBusiness
// blocks on the same page, which is exactly the "duplicate structured data"
// SEO checklist item flags.
const hasOwnLocalBusinessSchema = schema.some((s) => (s as { "@type"?: string } | null)?.["@type"] === "HomeAndConstructionBusiness");
const fullSchema = hasOwnLocalBusinessSchema ? schema : [localBusinessSchema(), ...schema];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#2a2763" />
    <!--
      Alpine.js evaluates x-data/x-show/@click expressions from HTML attributes
      via `new Function()`, which requires 'unsafe-eval' - without it Alpine
      (mega-menu, mobile nav, both widgets) silently fails everywhere. Moving
      off 'unsafe-eval' would mean switching to Alpine's restricted CSP build
      (@alpinejs/csp) and rewriting the dynamically-built directives in
      Header.astro to fit its safe-subset evaluator. Fine for a static
      marketing site with no auth/payment flows; revisit if that changes.
    -->
    <!--
      connect-src includes Sentry's managed-SaaS ingest hosts so
      error-monitoring.ts (src/scripts/error-monitoring.ts) actually has
      somewhere to report to once PUBLIC_SENTRY_DSN is set - without these,
      the SDK would load but every event send would be silently blocked by
      CSP, making the feature look configured while reporting nothing. Widen
      this (or point at your relay) if using a self-hosted Sentry instance.

      script-src/connect-src also allow Google's tag + analytics hosts for
      analytics.ts (src/scripts/analytics.ts) - same reasoning: without
      these, gtag.js would either fail to load or load and then have every
      hit silently blocked once PUBLIC_GA_MEASUREMENT_ID is set.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com; font-src 'self' data:; media-src 'self'; connect-src 'self' https://formspree.io https://*.sentry.io https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; base-uri 'self'; object-src 'none'"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Seo title={title} description={description} path={path} image={image} noindex={effectiveNoindex} schema={fullSchema} />
    <ClientRouter />
    <script src="../scripts/analytics.ts"></script>
    <script src="../scripts/error-monitoring.ts"></script>
  </head>
  <body class="bg-cream-50 text-ink-900 antialiased">
    <EmergencyBar />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <AccessibilityWidget />
    <ChatWidget />
    <!--
      alpine-init.ts calls Alpine.start(), which synchronously fires the
      "alpine:init" event that AccessibilityWidget/ChatWidget listen for to
      register their Alpine.data() components. Deferred module scripts run in
      document order, so this must load AFTER those components' own <script>
      tags above (which attach the alpine:init listeners) - moving it back to
      <head> silently breaks both widgets (Alpine.start() would fire, and thus
      alpine:init, before anything is listening).
    -->
    <script src="../scripts/alpine-init.ts"></script>
    <script src="../scripts/motion.ts"></script>
    <script src="../scripts/form-tracking.ts"></script>
  </body>
</html>
